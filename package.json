{
  "name": "iconicskies",
  "version": "2.0.0",
  "private": true,
  "description": "IconicSkies full-stack weather and Sky Journal app.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --no-warn-ignored --no-error-on-unmatched-pattern app components lib scripts tests *.ts *.tsx *.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:e2e",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.17.3",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/nextjs": "^10.31.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.561.0",
    "next": "16.2.7",
    "postgres": "^3.4.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "1.60.0",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
